{
  "manifest_version": 3,
  "name": "Rex Snap \u2014 Disappear From Meetings",
  "version": "1.1.0",
  "description": "Thanos-style snap effect for your webcam on ANY website or web app (Meet, Zoom Web, Teams, Discord, Whereby, Instagram, Omegle-style apps and more). 100% on-device.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rex Snap",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*/*",
        "http://localhost/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*",
        "snap-engine.js"
      ],
      "matches": [
        "https://*/*",
        "http://localhost/*"
      ]
    }
  ],
  "commands": {
    "toggle-snap": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Snap / Return (disappear from meeting)"
    }
  }
}